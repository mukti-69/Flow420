<?xml version="1.0" encoding="utf-8"?>
<!-- TuTube splash icon for the API 31+ native SplashScreen (shown
     instantly on cold start, before any Compose code runs - this is a
     separate mechanism from both the launcher icon and the in-app
     FlowSplashScreen.kt composable, and was still showing the old Flow
     "F" vector artwork until now). Reuses the same already-correctly-
     padded bitmap as the launcher icon foreground, since both follow the
     same 108dp-canvas/66dp-safe-zone convention. -->
<bitmap xmlns:android="http://schemas.android.com/apk/res/android"
    android:src="@drawable/tutube_icon_foreground_raw"
    android:gravity="center" />

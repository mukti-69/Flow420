<?xml version="1.0" encoding="utf-8"?>
<!-- TuTube launcher icon foreground. Replaces Flow's default vector
     (a simple red YouTube-play-glyph) with the actual provided TuTube
     logo artwork, wrapped as a bitmap drawable since it's raster art,
     not a vector shape. Padded/transparent-background PNG already
     sized to the adaptive-icon safe zone. -->
<bitmap xmlns:android="http://schemas.android.com/apk/res/android"
    android:src="@drawable/tutube_icon_foreground_raw"
    android:gravity="center" />
